{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cardinal",
  "colors": {
    "primary": "#5ECBE6",
    "light": "#79DDF2",
    "dark": "#2396B5"
  },
  "favicon": "https://app.cardinalweb3.com/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Cardinal App",
          "icon": "arrow-up-right-from-square",
          "href": "https://app.cardinalweb3.com"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/Cardinal-Web3"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Products",
        "icon": "grid-2",
        "pages": [
          "protection-api",
          "safesend",
          "escrow",
          "product-status"
        ]
      },
      {
        "group": "Transaction Control",
        "icon": "shield-halved",
        "pages": [
          "intelligence-evidence",
          "policy-engine",
          "safereceive",
          "transaction-simulation",
          "protected-transaction-lifecycle",
          "customer-portal-controls",
          "delivery-horizons"
        ]
      },
      {
        "group": "Developers",
        "icon": "code",
        "pages": [
          "integration-guide",
          "wallet-integration",
          "exchange-integration",
          "custodian-vault-integration",
          "rwa-high-value-payments"
        ]
      },
      {
        "group": "Security",
        "icon": "shield-check",
        "pages": [
          "security-best-practices"
        ]
      },
      {
        "group": "Resources",
        "icon": "book-open",
        "pages": [
          "knowledge-base",
          "support",
          "pilot-onboarding",
          "faq",
          "faq-troubleshooting",
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/cardinal-logo-light.png",
    "dark": "/logo/cardinal-logo-dark.png",
    "href": "https://app.cardinalweb3.com"
  },
  "navbar": {
    "links": [
      {
        "href": "https://app.cardinalweb3.com",
        "label": "Cardinal App"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Cardinal-Web3"
    }
  },
  "description": "Public product and developer documentation for Cardinal Web3 Security.",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F8FAFC",
      "dark": "#101218"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  }
}
